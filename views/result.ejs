<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Test Results - Typing Practice</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="result-page">
  <div class="theme-toggle">
    <button id="themeToggle" class="icon-btn" title="Toggle Theme">
      <span class="theme-icon">🌙</span>
    </button>
  </div>

  <main class="container">
    <div class="page-header">
      <a href="/" class="back-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Home
      </a>
      <h2>Test Results</h2>
    </div>

    <!-- Performance Rating -->
    <div class="rating-banner" id="ratingBanner">
      <div class="rating-circle">
        <span class="rating-letter" id="ratingLetter">A</span>
      </div>
      <div class="rating-info">
        <h3 id="ratingTitle">Excellent</h3>
        <p id="ratingDesc">Outstanding performance!</p>
      </div>
    </div>

    <!-- Metric Cards -->
    <div class="metrics-grid" id="metricsGrid">
      <div class="metric-card">
        <div class="metric-icon time-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="metric-value" id="metricTime">00:00</div>
        <div class="metric-label">Time Taken</div>
      </div>
      <div class="metric-card">
        <div class="metric-icon speed-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <div class="metric-value" id="metricGrossWpm">0</div>
        <div class="metric-label">Gross WPM</div>
      </div>
      <div class="metric-card">
        <div class="metric-icon net-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"/><path d="M18 20V5"/><path d="M6 20v-4"/></svg>
        </div>
        <div class="metric-value" id="metricNetWpm">0</div>
        <div class="metric-label">Net WPM</div>
      </div>
      <div class="metric-card">
        <div class="metric-icon acc-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="metric-value" id="metricAccuracy">0%</div>
        <div class="metric-label">Accuracy</div>
      </div>
      <div class="metric-card">
        <div class="metric-icon chars-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
        </div>
        <div class="metric-value" id="metricChars">0</div>
        <div class="metric-label">Chars Typed</div>
      </div>
      <div class="metric-card">
        <div class="metric-icon cpm-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        </div>
        <div class="metric-value" id="metricCpm">0</div>
        <div class="metric-label">Chars/Min</div>
      </div>
      <div class="metric-card">
        <div class="metric-icon error-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </div>
        <div class="metric-value" id="metricErrors">0</div>
        <div class="metric-label">Total Errors</div>
      </div>
      <div class="metric-card">
        <div class="metric-icon backspace-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4H8l-7 8 7 8h13a2 2 0 002-2V6a2 2 0 00-2-2z"/><line x1="18" y1="9" x2="12" y2="15"/><line x1="12" y1="9" x2="18" y2="15"/></svg>
        </div>
        <div class="metric-value" id="metricBackspaces">0</div>
        <div class="metric-label">Backspaces</div>
      </div>
    </div>

    <!-- Word Comparison -->
    <div class="card">
      <div class="card-header">
        <h3>Word Comparison</h3>
      </div>
      <div class="word-metrics-grid">
        <div class="word-metric correct-word"><span class="wm-label">Correct</span><span class="wm-value" id="correctWords">0</span></div>
        <div class="word-metric incorrect-word"><span class="wm-label">Wrong</span><span class="wm-value" id="incorrectWords">0</span></div>
        <div class="word-metric missing-word"><span class="wm-label">Missing</span><span class="wm-value" id="missingWords">0</span></div>
        <div class="word-metric extra-word"><span class="wm-label">Extra</span><span class="wm-value" id="extraWords">0</span></div>
      </div>
    </div>

    <!-- Character Comparison -->
    <div class="card">
      <div class="card-header">
        <h3>Character Comparison</h3>
      </div>
      <div class="word-metrics-grid">
        <div class="word-metric correct-word"><span class="wm-label">Correct</span><span class="wm-value" id="correctChars">0</span></div>
        <div class="word-metric incorrect-word"><span class="wm-label">Wrong</span><span class="wm-value" id="incorrectChars">0</span></div>
        <div class="word-metric missing-word"><span class="wm-label">Missing</span><span class="wm-value" id="missingChars">0</span></div>
        <div class="word-metric extra-word"><span class="wm-label">Extra</span><span class="wm-value" id="extraChars">0</span></div>
      </div>
    </div>

    <!-- Error Diff View -->
    <div class="card">
      <div class="card-header">
        <h3>Error Highlighting</h3>
        <p class="text-muted">Green = Correct, Red = Wrong, Orange = Missing, Blue = Extra</p>
      </div>
      <div class="diff-container">
        <div class="diff-section">
          <h4>Original Text</h4>
          <div id="diffOriginal" class="diff-content"></div>
        </div>
        <div class="diff-section">
          <h4>Your Typing</h4>
          <div id="diffTyped" class="diff-content"></div>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="result-actions">
      <a href="/input" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        New Test
      </a>
      <button id="exportPdfBtn" class="btn btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Export PDF
      </button>
      <button id="exportCsvBtn" class="btn btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Export CSV
      </button>
      <button id="exportJsonBtn" class="btn btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Export JSON
      </button>
      <a href="/history" class="btn btn-secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        History
      </a>
    </div>
  </main>

  <script src="/js/main.js"></script>
  <script>
    const savedTheme = localStorage.getItem('typing-theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
  </script>
</body>
</html>
